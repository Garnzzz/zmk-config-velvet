#define BASE 0
#define LOWER 1
#define MOUSE_KEYS 2
#define MOUSE_TP 3
#define MOUSE_TP_SET 4

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

        tap-ms = <100>;
    };

    behaviors {
        mtq: mtq {
            compatible = "zmk,behavior-hold-tap";
            label = "MTQ";
            bindings = <&mt>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        LTQ: LTQ {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        flash {
            bindings = <&bootloader>;
            key-positions = <0 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp ESC  &kp N1              &kp N2               &kp N3          &kp N4            &kp N5              &kp NUMBER_6  &kp N7       &kp N8           &kp N9           &kp N0                        &kp BACKSPACE
&kp TAB  &kp Q               &kp W                &kp E           &kp R             &kp T    &mkp RCLK  &kp Y         &kp U        &kp I            &kp O            &kp P                         &kp BSLH
&mo 5    &mt LEFT_CONTROL A  &mt LEFT_GUI S       &mt LEFT_ALT D  &mt LEFT_SHIFT F  &kp G    &mkp MCLK  &kp H         &mt RSHFT J  &mt RIGHT_ALT K  &mt RIGHT_GUI L  &mt RIGHT_CONTROL APOSTROPHE  &kp SEMICOLON
&mo 3    &mt LC(Z) Z         &mt LC(X) X          &mt LC(C) C     &mt LC(V) V       &kp B    &mkp LCLK  &kp N         &kp M        &kp COMMA        &kp PERIOD       &kp SLASH                     &mo 3
         &kp TILDE           &kp LA(PRINTSCREEN)  &lt 5 ESCAPE    &lt 1 BACKSPACE   &kp TAB             &kp RET       &lt 2 SPACE  &sk LSHFT        &kp MINUS        &kp EQUAL
            >;

            label = "BASE";
            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        LOWER {
            bindings = <
&none   &none      &none     &none      &none     &none            &none    &none          &none       &none   &none    &none
&none   &kp N1     &kp N2    &kp N3     &kp N4    &kp N5   &trans  &kp N6   &kp N7         &kp N8      &kp N9  &kp N0   &none
&none   &kp F1     &kp F2    &kp F3     &kp F4    &kp F5   &trans  &kp F6   &kp F7         &kp F8      &kp F9  &kp F10  &none
&trans  &kp SLASH  &kp STAR  &kp MINUS  &kp PLUS  &kp F11  &trans  &kp F12  &trans         &trans      &trans  &trans   &trans
        &trans     &trans    &trans     &trans    &trans           &trans   &kp BACKSPACE  &kp ESCAPE  &none   &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        RAISE {
            bindings = <
&kp TILDE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5          &trans        &trans        &trans        &trans        &trans          &kp F12
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &kp UP_ARROW  &trans        &trans          &trans
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans        &kp LEFT      &kp DOWN      &kp RIGHT     &trans          &trans
&trans     &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
           &trans  &trans  &trans  &trans  &trans          &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        MEDIA_ADJ {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &none         &none  &bt BT_SEL 4  &out OUT_TOG  &none       &bt BT_CLR_ALL  &none
&to 6  &none         &none         &none             &none         &none  &none  &none  &none         &none         &none       &bt BT_CLR      &to 6
&to 4  &none         &none         &none             &none         &none  &none  &none  &none         &none         &none       &none           &to 4
&none  &none         &none         &none             &none         &none  &none  &none  &none         &none         &none       &none           &none
       &kp C_PREV    &kp C_NEXT    &kp C_PLAY_PAUSE  &none         &none         &none  &none         &kp C_PP      &kp C_PREV  &kp C_NEXT
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        CHANGE {
            bindings = <
&trans  &trans     &trans        &trans        &trans         &trans              &trans  &trans          &trans        &trans    &trans     &trans
&trans  &kp N1     &kp N2        &kp N3        &kp N4         &kp N5      &to 0   &kp N6  &kp N7          &kp N8        &kp N9    &kp N0     &trans
&trans  &kp LCTRL  &kp LEFT_GUI  &kp LALT      &kp LSHFT      &lt 5 HOME  &trans  &trans  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN  &kp RIGHT  &trans
&trans  &kp LC(Z)  &kp LC(X)     &kp LC(C)     &kp LC(V)      &kp END     &trans  &trans  &kp COLON       &kp MINUS     &kp DOT   &kp SLASH  &trans
        &trans     &trans        &mtq ESC RET  &kp BACKSPACE  &kp TAB             &trans  &trans          &trans        &trans    &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        GAME {
            bindings = <
&kp ESC    &kp N1  &kp N2        &kp N3  &kp N4     &kp N5          &kp N6     &kp N7    &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W         &kp E   &kp R      &kp T   &to 0   &kp Y      &kp U     &kp I      &kp O    &kp P     &kp BSLH
&kp LSHFT  &kp A   &kp S         &kp D   &kp F      &kp G   &trans  &kp H      &kp J     &kp K      &kp L    &kp APOS  &trans
&kp LCTRL  &kp Z   &kp X         &kp C   &kp V      &kp B   &trans  &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &trans
           &trans  &kp LEFT_ALT  &trans  &kp SPACE  &trans          &kp ENTER  &kp BSPC  &kp TILDE  &trans   &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
